#!/bin/sh
# Обёртка python3 для кода учеников: server.js находит её первой в PATH (см. deploy/app.service.in).
# Лимиты процесса: 256 МБ памяти (как в паспорте задач), 2 с CPU, файлы до 16 МБ, 64 дескриптора, без core-файлов.
# Остальная изоляция (отдельный пользователь, без сети, ФС только на чтение, лимит процессов) — в юните systemd.
exec /usr/bin/prlimit --as=268435456 --cpu=2 --fsize=16777216 --nofile=64 --core=0 -- /usr/bin/python3 "$@"
