# @APP_NAME@: nginx перед приложением. Ставит deploy/web.sh, @…@ подставляются при установке.
# HTTP и все домены, кроме основного, перенаправляются на https://@PRIMARY@.
limit_req_zone $binary_remote_addr zone=@APP_NAME@_submit:10m rate=30r/m;

upstream @APP_NAME@_app {
    server 127.0.0.1:@PORT@;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name @DOMAINS@;

    # продление сертификата идёт через этот каталог
    location ^~ /.well-known/acme-challenge/ {
        root @WEBROOT@;
        default_type text/plain;
    }

    location / {
        return 301 https://@PRIMARY@$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name @DOMAINS@;

    ssl_certificate     @CERT_DIR@/fullchain.pem;
    ssl_certificate_key @CERT_DIR@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:@APP_NAME@_ssl:10m;
    ssl_session_timeout 1d;

    if ($host != "@PRIMARY@") {
        return 301 https://@PRIMARY@$request_uri;
    }

    client_max_body_size 12m;  # скриншоты учеников — до 10 МБ (/api/uploads)
    gzip on;
    gzip_types text/css text/javascript application/javascript application/json;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # отправка решений запускает Python — ограничиваем частоту с одного адреса
    location ~ ^/api/steps/[^/]+/submissions$ {
        limit_req zone=@APP_NAME@_submit burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://@APP_NAME@_app;
    }

    location / {
        proxy_pass http://@APP_NAME@_app;
    }
}
